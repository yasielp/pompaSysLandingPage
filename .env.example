# Brevo API key used by /api/contact to send the contact form emails.
BREVO_API_KEY=

# Optional overrides
# CONTACT_TO=pompasys@gmail.com
# CONTACT_FROM=noreply@pompasys.com
# Folder where messages are saved if the email cannot be sent (default: ./data)
# CONTACT_FAILED_DIR=/var/lib/pompasys

# Behind Cloudflare: trust only this header for the visitor IP (see README before enabling).
# CLIENT_IP_HEADER=cf-connecting-ip

# Cloudflare Turnstile captcha (optional). The form requires it only when BOTH are set.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
